{
  "collectionName": "components_facts_quantity_ranges",
  "info": {
    "displayName": "QuantityRange",
    "description": "Numeric range with unit and display value."
  },
  "attributes": {
    "min": {
      "type": "decimal",
      "required": true
    },
    "max": {
      "type": "decimal",
      "required": true
    },
    "unit": {
      "type": "enumeration",
      "required": true,
      "enum": ["pa", "kpa", "mpa", "bar", "mbar", "psi", "mh2o", "mm", "m", "c", "f", "k", "ma", "v", "mv", "hz", "percent", "ph", "us_cm", "cycle", "custom"]
    },
    "display": {
      "type": "string",
      "required": true
    }
  }
}
