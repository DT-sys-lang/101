{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:industrial-sensors:product-geo-ai-profile:v1",
  "title": "Product GEO AI Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["governance", "entity", "answerSummary", "factTable", "selectionGuidance", "evidence", "faq"],
  "properties": {
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "locale", "lastReviewedAt", "reviewedBy", "allowedForAiExtraction"],
      "properties": {
        "schemaVersion": { "const": "product-geo-ai-profile-v1" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "enum": ["domain-owner", "product-engineering", "technical-marketing"] },
        "allowedForAiExtraction": { "type": "boolean" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "canonicalName", "model", "brand", "canonicalPath", "categoryIds"],
      "properties": {
        "productId": { "type": "string", "pattern": "^prd_" },
        "canonicalName": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "brand": { "type": "string", "minLength": 1 },
        "canonicalPath": { "type": "string", "pattern": "^/products/.+" },
        "categoryIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^cat_" }
        },
        "sameAs": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "answerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneSentence", "shortParagraph", "technicalAbstract", "primaryUseCases"],
      "properties": {
        "oneSentence": { "type": "string", "minLength": 20, "maxLength": 240 },
        "shortParagraph": { "type": "string", "minLength": 40, "maxLength": 900 },
        "technicalAbstract": { "type": "string", "minLength": 40, "maxLength": 1400 },
        "primaryUseCases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "notRecommendedFor": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "factTable": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    },
    "selectionGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bestFor", "decisionCriteria"],
      "properties": {
        "bestFor": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "decisionCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "compatibleMedia": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "installationNotes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredOptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sourceType"],
        "properties": {
          "id": { "type": "string", "pattern": "^evidence_" },
          "title": { "type": "string", "minLength": 1 },
          "sourceType": { "enum": ["datasheet", "manual", "certificate", "test-report", "catalog", "engineering-note"] },
          "href": { "type": "string" },
          "revision": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+){0,2}$" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer", "audience", "sourceRefs"],
        "properties": {
          "question": { "type": "string", "minLength": 5 },
          "answer": { "type": "string", "minLength": 10 },
          "audience": { "enum": ["buyer", "engineer", "oem", "maintenance", "ai-assistant"] },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/sourceRef" }
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimType", "label", "value", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^evidence_" },
        "claimType": {
          "enum": [
            "identity",
            "capability",
            "measurement-range",
            "compatibility",
            "installation",
            "compliance",
            "limitation",
            "selection-guidance"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^(doc_|evidence_)" },
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "confidence": { "enum": ["source-backed", "derived", "editorial", "unverified"] }
      }
    }
  }
}
