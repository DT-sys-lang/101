{
  "kind": "collectionType",
  "collectionName": "category_facts",
  "info": {
    "singularName": "category-fact",
    "pluralName": "category-facts",
    "displayName": "CategoryFact",
    "description": "Facts-only category node. Routing fields are generated by adapter."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "factId": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^cat_[a-z0-9_]+$"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category-fact.category-fact"
    },
    "name": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "facts.localized-text"
    }
  }
}
