# Copy this file to deploy/production.env on the server and replace every
# placeholder. Do not commit deploy/production.env.

COMPOSE_PROJECT_NAME=yufavor-cms
STRAPI_HOST_PORT=1337

# Runtime compose image references. Use docker-compose.runtime.yml on low-memory
# production servers so the server pulls this image instead of building it.
STRAPI_IMAGE=ghcr.io/dt-sys-lang/101-strapi-cms:main
STRAPI_PULL_POLICY=missing
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
POSTGRES_PULL_POLICY=missing

# Strapi server
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://cms.example.com
STRAPI_ADMIN_BACKEND_URL=https://cms.example.com

# Generate unique random values for every production environment.
APP_KEYS=replace-with-random-key-1,replace-with-random-key-2,replace-with-random-key-3,replace-with-random-key-4
API_TOKEN_SALT=replace-with-random-api-token-salt
ADMIN_JWT_SECRET=replace-with-random-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-random-transfer-token-salt
JWT_SECRET=replace-with-random-jwt-secret
ENCRYPTION_KEY=replace-with-random-encryption-key

# PostgreSQL container. Keep DATABASE_* and POSTGRES_* in sync.
POSTGRES_USER=strapi
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=industrial_cms
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=industrial_cms
DATABASE_SCHEMA=public
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace-with-strong-postgres-password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=60000

# Private CMS API boundary. Match these with the Next.js server env.
STRAPI_REST_PREFIX=/internal/cms
INTERNAL_CMS_FACTS_TOKEN=replace-with-shared-internal-cms-facts-token
INTERNAL_CMS_INQUIRY_TOKEN=replace-with-shared-internal-cms-inquiry-token

# Production CORS must list only approved site and preview origins.
STRAPI_CORS_ORIGINS=https://www.example.com,https://preview.example.com
STRAPI_REST_DEFAULT_LIMIT=100
STRAPI_REST_MAX_LIMIT=100
STRAPI_BODY_FORM_LIMIT=5mb
STRAPI_BODY_JSON_LIMIT=5mb
STRAPI_BODY_TEXT_LIMIT=5mb
STRAPI_UPLOAD_MAX_FILE_SIZE=209715200
STRAPI_UPLOAD_SIZE_LIMIT=209715200

# S3-compatible upload storage. Use aws-s3 for R2/OSS/COS/S3 production media.
STRAPI_UPLOAD_PROVIDER=aws-s3
STRAPI_S3_ACCESS_KEY_ID=replace-with-access-key
STRAPI_S3_SECRET_ACCESS_KEY=replace-with-secret-key
STRAPI_S3_REGION=auto
STRAPI_S3_ENDPOINT=https://replace-with-account-or-region-endpoint
STRAPI_S3_BUCKET=replace-with-bucket
STRAPI_S3_ACL=
STRAPI_S3_FORCE_PATH_STYLE=false
STRAPI_UPLOAD_BASE_URL=https://media.example.com
STRAPI_UPLOAD_ROOT_PATH=
STRAPI_CSP_MEDIA_HOSTS=https://media.example.com

# Backup policy for the postgres-backup service.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Optional production hardening.
STRAPI_TELEMETRY_DISABLED=true
