# Frontend runtime configuration
# Public production origin. Used for canonical URLs, sitemap, robots, JSON-LD,
# Google Search Console verification, and Open Graph metadata.
NEXT_PUBLIC_SITE_ORIGIN=https://www.example.com

# Google integrations. Leave empty in local development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Choose one mode for production:
# - cms-facts-api: fetch live facts from Strapi
# - env-facts-json: read a committed JSON fallback from outputs/cms-facts.json
CMS_SOURCE_MODE=cms-facts-api

# Live Strapi facts API mode
CMS_FACTS_API_URL=https://your-strapi-service.up.railway.app/internal/cms/facts
CMS_FACTS_API_ALLOW_FETCH=true
CMS_FACTS_API_TOKEN=replace-with-shared-internal-cms-facts-token
CMS_FACTS_API_TIMEOUT_MS=5000

# Strapi editorial resources API mode
# Used by /resources/blog, /resources/cases, and /resources/manuals.
# Set to the Strapi origin, /internal/cms REST root, or /api REST root.
# This project defaults an origin-only value to /internal/cms.
CMS_RESOURCES_API_URL=https://your-strapi-service.up.railway.app
CMS_RESOURCES_API_TOKEN=replace-with-optional-strapi-content-api-token
# Strapi 5 uses `status=published` query parameters for editorial collections.
CMS_STRAPI_API_VERSION=5
CMS_RESOURCES_API_TIMEOUT_MS=5000

# Static JSON fallback mode
# Used when CMS_SOURCE_MODE=env-facts-json, or as a fallback source when the API is unavailable.
# The application resolves this basename under outputs/.
CMS_FACTS_JSON_FILE=cms-facts.json

# CMS webhook and preview secrets
CMS_REVALIDATE_SECRET=replace-with-random-revalidate-secret
CMS_PREVIEW_SECRET=replace-with-random-preview-secret

# Optional local/runtime storage override for inquiry JSONL records.
# Do not rely on local filesystem persistence for serverless production deployments.
# INQUIRY_STORE_DIR=/persistent/runtime/inquiry

# Production inquiry persistence. When both values are set, /api/inquiry writes
# to Strapi/PostgreSQL instead of local JSONL files.
STRAPI_INQUIRY_API_URL=https://cms.example.com/internal/cms/inquiries
STRAPI_INQUIRY_API_TOKEN=replace-with-shared-internal-cms-inquiry-token
STRAPI_INQUIRY_API_TIMEOUT_MS=5000

# Optional inquiry email notifications through Resend.
RESEND_API_KEY=
RESEND_EMAIL_API_URL=https://api.resend.com/emails
RESEND_EMAIL_TIMEOUT_MS=5000
INQUIRY_EMAIL_FROM=YUFAVOR <inquiry@example.com>
INQUIRY_EMAIL_TO=sales@example.com
INQUIRY_EMAIL_REPLY_TO=
